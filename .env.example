# Environment Variables - EXAMPLE
# Copy this to .env.local and fill in actual values
# .env.local is gitignored and never committed to the repository

# ===== PUBLIC CLIENT CONFIG (safe to expose to browser) =====
# These are Supabase's public/anonymous credentials for the frontend
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your_project.supabase.co

# ===== SERVER-ONLY SECRETS (must NEVER reach browser) =====
# These are used only on the server and never bundled into client JS

# Supabase server configuration
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI API configuration
LOVABLE_API_KEY=your_lovable_api_key

# Node environment
NODE_ENV=development

# ===== ADMIN CONFIGURATION =====
# Comma-separated list of admin email addresses
ADMIN_EMAILS=aarushmahajan2008@gmail.com

# Feature flags (optional)
FEATURE_ADMIN_PANEL=true
